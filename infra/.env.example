# Copy to infra/.env (git-ignored). Dev-only values — never reuse in production.
POSTGRES_DB=nozie
POSTGRES_USER=nozie
POSTGRES_PASSWORD=change-me-dev-only
MINIO_ROOT_USER=nozie
MINIO_ROOT_PASSWORD=change-me-dev-only
CORS_ALLOWED_ORIGINS=

# API (generate with: openssl rand -base64 48)
JWT_SECRET=change-me-generate-a-random-48-byte-secret
# Comma-separated Google OAuth client ids (web/android/ios) accepted for /auth/google
GOOGLE_CLIENT_IDS=
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@nozie.local

# Stripe (test-mode keys from the Stripe dashboard; webhook secret from `stripe listen`)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
POSTGRES_PORT=5432
